# Guardian Configuration
# Add these variables to your .env file

# Guardian Feature Flag
GUARDIAN_ENABLED=true

# Guardian Security Settings
GUARDIAN_REQUIRE_APPROVAL=true
GUARDIAN_DRY_RUN=false
GUARDIAN_MAX_RETRIES=3
GUARDIAN_TIMEOUT=1800

# Guardian Backup Settings
GUARDIAN_BACKUP_DIR=/tmp/guardian_backups
GUARDIAN_BACKUP_RETENTION_DAYS=30

# Guardian Auto-Approval (use with extreme caution in production)
GUARDIAN_ENABLE_AUTO_APPROVAL=false
GUARDIAN_AUTO_APPROVE_RISK_LEVELS=low

# Guardian Logging
GUARDIAN_LOG_LEVEL=info
GUARDIAN_LOG_FILE=/var/log/pentagi/guardian.log
